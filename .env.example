BOT_NAME=Voltron
OWNER_NAME=Tobe

# Command prefix
PREFIX=.

# Your WhatsApp number with country code, digits only (e.g. 2348012345678).
# Used to recognise you as the owner, and to log in with a pairing code instead of a QR.
OWNER_NUMBER=

# private = only you and sudo users can use commands, public = everyone
MODE=private

# Set to true to log in with an 8-character pairing code instead of scanning a QR
USE_PAIRING_CODE=false

# Default sticker metadata (defaults to the bot name / owner name)
STICKER_PACK=Voltron
STICKER_AUTHOR=Tobe

# Automatically forward every view-once photo/video/voice note you receive to your own chat
AUTO_SAVE_VIEWONCE=false

# Max upload size in MB for downloaded videos/audio
MAX_MB=60

# Longest song .play will send, in minutes
MAX_SONG_MINUTES=20

# Default language for .tts (en, fr, es, pt-BR ...)
TTS_LANG=en

# ---------- AI assistant ----------
# Name people call it by ("riri play ..."). The bot name (Voltron) works too.
AI_NAME=Riri

# anthropic (default) or openai (any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Gemini...)
AI_PROVIDER=anthropic
AI_API_KEY=

# Optional. Defaults: claude-haiku-4-5-20251001 (anthropic) / gpt-4o-mini (openai)
AI_MODEL=
# Optional. Only needed for non-default endpoints, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=

# Send "hello its tobe.." then edit it to "voltron is ready.." to your DM when the bot connects
STARTUP_MESSAGE=true

# Time zone used when anti-delete / anti-edit show the message time
TIMEZONE=Africa/Lagos

# ---------- Deployment extras ----------
# Warnings before a member is removed by .warn / anti-link / anti-word
WARN_LIMIT=3

# Hosts with NO persistent disk (Heroku, Koyeb, Render free...): link once, send .exportsession to the bot,
# paste what it gives you here, and the login survives every redeploy.
# Best for hosts with no disk: a Postgres URL keeps the login + settings across every restart (Neon, Supabase, Railway...)
DATABASE_URL=

SESSION_ID=

# Set automatically by most web hosts. When present the bot opens a tiny health page on that port.
# PORT=3000

# ---------- yt-dlp (.play / downloads) ----------
# Path to a YouTube cookies.txt if you keep it outside the project (otherwise use .setcookies)
# YTDLP_COOKIES=/path/to/cookies.txt
# Set to true if you install yt-dlp yourself and do not want ./bin/yt-dlp downloaded and auto-updated
# YTDLP_SKIP_DOWNLOAD=false

# ---------- Update notifications ----------
# The bot checks its GitHub repo every 10 minutes and DMs you "UPDATE NOW" with the new commit messages.
UPDATE_NOTIFY=true
# UPDATE_REPO=teethaking/Voltron-WhatsApp-AI-Bot
# UPDATE_BRANCH=main
